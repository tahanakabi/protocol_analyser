OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Hybrid retrieval (fields and chat)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_EXTRA_BLOCKS=6
CHAT_TOP_K=8
# Smaller models: lower budget (~12k-24k). Large context: raise toward 80000.
LLM_CONTEXT_CHAR_BUDGET=24000
MAX_BLOCK_TEXT_CHARS=1200
RETRIEVAL_MIN_BLOCKS=6
